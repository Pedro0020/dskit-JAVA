# ─────────────────────────────────────────────────────────────────────────────
#  .env.example
#  Copia este archivo como .env y rellena los valores reales.
#  El archivo .env NO debe subirse a git (ya está en .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── Proyecto ─────────────────────────────────────────────────────────────────
PROJECT_NAME="{{ project_name }}"
SPRING_PROFILES_ACTIVE=dev

# ── Base de datos ────────────────────────────────────────────────────────────
# application.yml lee estas variables cuando db != h2.
# Ajusta la URL al motor elegido (postgres/mysql).
# DB_URL=jdbc:postgresql://localhost:5432/{{ project_slug }}
# DB_USER=usuario
# DB_PASSWORD=contraseña_secreta

# ── Observabilidad (si use_observability) ────────────────────────────────────
# MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,prometheus

{% if use_graphify %}
# ── Graphify (capa semántica opcional del vault) ─────────────────────────────
# Gratis en ai.google.dev. Sin clave, usa `make knowledge` (grafo determinista).
# GEMINI_API_KEY=AIza...
{% endif %}

# ── Logging ──────────────────────────────────────────────────────────────────
# LOGGING_LEVEL_ROOT=INFO
